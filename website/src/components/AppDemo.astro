---
// Interactive preview of the Aoze window, drawn in HTML from the app's own layout, colours and
// wording (src/app, src/features, src/styles/tokens.css). Only the four main sections of the
// sidebar (and the Home cards that lead to them) do something: they switch the view, as in
// the app. Settings are drawn as plain text, not as controls. No file is ever processed.
import NightScene from "./NightScene.astro";
import DemoField from "./demo/DemoField.astro";
import { href } from "../lib/site";
import { ui, type Lang } from "../i18n/ui";

interface Props { lang: Lang; version: string }
const { lang, version } = Astro.props;
const d = ui[lang].demo;

// Lucide icons, as in the app (lucide-react).
const icon = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  image: '<path d="M18 22H4a2 2 0 0 1-2-2V6"/><path d="m22 13-1.296-1.296a2.41 2.41 0 0 0-3.408 0L11 18"/><circle cx="12" cy="8" r="2"/><rect width="16" height="16" x="6" y="2" rx="2"/>',
  clip: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/>',
  convert: '<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>',
  history: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  settings: '<path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/>',
  help: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  coffee: '<path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  trash: '<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
  minus: '<path d="M5 12h14"/>',
  sparkles: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  play: '<polygon points="6 3 20 12 6 21 6 3"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  chevronRight: '<path d="m9 18 6-6-6-6"/>',
  fit: '<path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>',
  full: '<path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/>',
};
const sections = [
  { id: "home", label: d.nav.home, badge: null },
  { id: "image", label: d.nav.image, badge: "1" },
  { id: "clip", label: d.nav.clip, badge: "1" },
  { id: "convert", label: d.nav.convert, badge: "1" },
] as const;
const initial = "image";
---
<figure class="window demo" data-demo>
  <div class="app" role="group" aria-label={d.label}>
    <!-- Title bar -->
    <div class="tb" aria-hidden="true">
      <span class="tb-brand">
        <svg viewBox="250 210 600 600" width="17" height="17">
          <defs><linearGradient id="demo-ac" gradientUnits="userSpaceOnUse" x1="392" y1="0" x2="862" y2="0"><stop offset="0" stop-color="#2bb8d6" /><stop offset="1" stop-color="#5ff0d4" /></linearGradient></defs>
          <path d="M292 772 L512 248 L732 772" fill="none" stroke="currentColor" stroke-width="96" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M392 616 L790 616" fill="none" stroke="url(#demo-ac)" stroke-width="76" stroke-linecap="round" />
          <circle cx="790" cy="616" r="60" fill="url(#demo-ac)" />
        </svg>
        <span class="tb-sep"></span>
        Aoze
      </span>
      <span class="tb-right">
        <span class="tb-status"><span class="tb-dot"></span>{d.status}</span>
        <span class="tb-line tb-extra"></span>
        <svg class="tb-icon tb-extra" viewBox="0 0 24 24" set:html={icon.sun} />
        <svg class="tb-icon tb-extra" viewBox="0 0 24 24" set:html={icon.info} />
        <span class="tb-line tb-extra"></span>
        <span class="tb-win"><svg viewBox="0 0 24 24" set:html={icon.minus} /></span>
        <span class="tb-win"><svg viewBox="0 0 12 12"><rect x="1.5" y="1.5" width="9" height="9" rx="1" /></svg></span>
        <span class="tb-win"><svg viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></span>
      </span>
    </div>

    <div class="body">
      <!-- Sidebar -->
      <nav class="sb" aria-label={d.label}>
        <div class="sb-group sb-tabs" role="tablist" aria-orientation="vertical">
          <span class="sb-hl" aria-hidden="true"><span class="sb-line"></span></span>
          {sections.map((sec) => (
            <button type="button" class="sb-i" role="tab" id={`demo-tab-${sec.id}`} aria-controls={`demo-view-${sec.id}`}
                    aria-selected={String(sec.id === initial)} tabindex={sec.id === initial ? 0 : -1} data-view={sec.id}>
              <svg class="sb-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icon[sec.id]} />
              <span class="sb-label">{sec.label}</span>
              {sec.badge && <span class="sb-badge" aria-hidden="true">{sec.badge}</span>}
            </button>
          ))}
        </div>
        <div class="sb-secondary" aria-hidden="true">
          <span class="sb-div"></span>
          {(["history", "settings", "help"] as const).map((k) => (
            <span class="sb-i sb-static"><svg class="sb-icon" viewBox="0 0 24 24" set:html={icon[k]} /><span class="sb-label">{d.nav[k]}</span></span>
          ))}
        </div>
        <span class="sb-spacer"></span>
        <span class="sb-i sb-static sb-support" aria-hidden="true"><svg class="sb-icon" viewBox="0 0 24 24" set:html={icon.coffee} /><span class="sb-label">{d.nav.support}</span></span>
        <span class="sb-version">Aoze <span data-r="version">{version}</span></span>
      </nav>

      <div class="views">
        <!-- Home -->
        <div class="view v-home" id="demo-view-home" role="tabpanel" aria-labelledby="demo-tab-home" hidden>
          <NightScene class="demo-night" stars={50} />
          <div class="home-center">
            <svg class="home-logo" viewBox="250 210 600 600" width="40" height="40" aria-hidden="true">
              <path d="M292 772 L512 248 L732 772" fill="none" stroke="currentColor" stroke-width="96" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M392 616 L790 616" fill="none" stroke="url(#demo-ac)" stroke-width="76" stroke-linecap="round" />
              <circle cx="790" cy="616" r="60" fill="url(#demo-ac)" />
            </svg>
            <p class="home-title">{d.home.title}</p>
            <div class="home-grid">
              {([["image", d.home.imageTitle, d.home.imageBody, d.home.formatsImage], ["clip", d.home.clipTitle, d.home.clipBody, d.home.formatsClip]] as const).map(([id, title, body, formats]) => (
                <button type="button" class="card" data-go={id}>
                  <span class="card-art" aria-hidden="true"></span>
                  <span class="card-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon[id]} /></span>
                  <span class="card-title">{title}</span>
                  <span class="card-body">{body}</span>
                  <span class="card-chips" aria-hidden="true">{formats.map((f) => <span>{f}</span>)}</span>
                  <span class="card-cta">{d.home.browse}<svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.arrow} /></span>
                </button>
              ))}
              <div class="card-convert">
                <span class="card-icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.convert} /></span>
                <span class="cc-text"><span class="card-title">{d.home.convertTitle}</span><span class="card-body">{d.home.convertBody}</span></span>
                <button type="button" class="cc-btn" data-go="convert"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon.arrow} />{d.home.openConvert}</button>
              </div>
            </div>
            <p class="home-foot" aria-hidden="true">{d.home.drop}<span class="home-dot"></span><span class="home-how"><svg viewBox="0 0 24 24" set:html={icon.help} />{d.home.how}</span></p>
          </div>
          <p class="home-sign" aria-hidden="true">Made for aoxy, by zero.</p>
        </div>

        <!-- Image & GIF -->
        <div class="view" id="demo-view-image" role="tabpanel" aria-labelledby="demo-tab-image">
          <div class="stage">
            <div class="st-head">
              <span class="st-name">{d.image.file}</span><span class="st-meta">{d.image.meta}</span>
              <span class="st-actions" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.trash} /><span class="st-add"><svg viewBox="0 0 24 24" set:html={icon.plus} />{d.addFiles}</span></span>
            </div>
            <div class="st-area">
              <span class="st-tag" aria-hidden="true">{d.original}</span>
              <span class="st-wait" aria-hidden="true">{d.image.waiting}</span>
              <img class="st-img" src={href("demo/image-original.jpg")} width="400" height="250" alt={d.image.alt} loading="lazy" decoding="async" />
              <span class="st-zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={icon.minus} /><span>46%</span><svg viewBox="0 0 24 24" set:html={icon.plus} />
                <span class="st-zsep"></span><svg viewBox="0 0 24 24" set:html={icon.fit} /><svg viewBox="0 0 24 24" set:html={icon.full} />
              </span>
            </div>
          </div>
          <aside class="panel" aria-hidden="true">
            <div class="p-scroll">
              <DemoField opts={d.image.presets} active={3} chips />
              <DemoField label={d.image.action} opts={d.image.actionOpts} active={0} />
              <DemoField label={d.image.style} opts={d.image.styleOpts} active={0} secondary />
              <DemoField label={d.image.size} opts={["1×", "1.6×", "2×", "4×", "8×"]} active={3} aside={d.image.sizeAside} />
              <DemoField label={d.image.noise} opts={d.image.noiseOpts} active={2} />
              <DemoField label={d.image.discord} opts={d.image.discordOpts} active={0} chips secondary />
              <div class="p-section p-secondary"><svg viewBox="0 0 24 24" set:html={icon.chevron} />{d.output}</div>
              <DemoField label={d.image.format} opts={["PNG", "JPEG", "WEBP"]} active={0} secondary />
              <DemoField label={d.image.maxSize} opts={d.image.maxSizeOpts} active={0} secondary />
            </div>
            <div class="p-foot">
              <span class="p-btn"><svg viewBox="0 0 24 24" set:html={icon.sparkles} />{d.image.button}</span>
              <span class="p-kbd">Ctrl + Enter</span>
            </div>
          </aside>
        </div>

        <!-- Clip -->
        <div class="view" id="demo-view-clip" role="tabpanel" aria-labelledby="demo-tab-clip" hidden>
          <div class="stage">
            <div class="st-head">
              <span class="st-name">{d.clip.file}</span><span class="st-meta">{d.clip.meta}</span>
              <span class="st-actions" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.trash} /><span class="st-add"><svg viewBox="0 0 24 24" set:html={icon.plus} />{d.addFiles}</span></span>
            </div>
            <div class="st-area st-clip">
              <span class="st-tag" aria-hidden="true">{d.original}</span>
              <span class="frame"><img src={href("demo/motion-poster.jpg")} width="1280" height="360" alt={d.clip.alt} loading="lazy" decoding="async" /></span>
              <span class="timeline" aria-hidden="true">
                <svg class="tl-play" viewBox="0 0 24 24" set:html={icon.play} />
                <span class="tl-track"><span class="tl-fill"></span><span class="tl-thumb"></span></span>
                <span class="tl-time">{d.clip.time}</span>
              </span>
            </div>
          </div>
          <aside class="panel" aria-hidden="true">
            <div class="p-scroll">
              <DemoField opts={d.clip.presets} active={1} chips />
              <DemoField label={d.clip.size} opts={d.clip.sizeOpts} active={0} secondary />
              <DemoField label={d.clip.enhance} opts={d.clip.enhanceOpts} active={1} />
              <DemoField label={d.clip.smooth} opts={d.clip.smoothOpts} active={1} hint={d.clip.smoothHint} />
              <DemoField label={d.clip.blur} opts={d.clip.blurOpts} active={1} secondary />
              <DemoField label={d.clip.hdr} opts={d.clip.hdrOpts} active={1} aside={d.clip.hdrAside} />
              <div class="p-section p-secondary p-closed"><svg viewBox="0 0 24 24" set:html={icon.chevronRight} />{d.clip.look}</div>
              <div class="p-section p-secondary"><svg viewBox="0 0 24 24" set:html={icon.chevron} />{d.output}</div>
              <DemoField label={d.quality} opts={d.qualityOpts} active={1} secondary />
            </div>
            <div class="p-foot">
              <span class="p-btn"><svg viewBox="0 0 24 24" set:html={icon.sparkles} />{d.clip.button}</span>
              <span class="p-kbd">Ctrl + Enter</span>
            </div>
          </aside>
        </div>

        <!-- Convert -->
        <div class="view" id="demo-view-convert" role="tabpanel" aria-labelledby="demo-tab-convert" hidden>
          <div class="stage">
            <div class="st-head">
              <span class="st-name">{d.convert.title}</span>
              <span class="st-actions" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.trash} /><span class="st-add"><svg viewBox="0 0 24 24" set:html={icon.plus} />{d.addFiles}</span></span>
            </div>
            <div class="cv-body">
              <div class="cv-card">
                <span class="cv-label">{d.convert.input}</span>
                <span class="cv-thumb"><img src={href("demo/motion-poster.jpg")} width="1280" height="360" alt="" loading="lazy" decoding="async" /></span>
                <span class="cv-name">{d.convert.file}</span>
                <dl class="cv-facts">
                  {d.convert.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
                </dl>
              </div>
              <svg class="cv-arrow" viewBox="0 0 24 24" aria-hidden="true" set:html={icon.arrow} />
              <div class="cv-card cv-out">
                <span class="cv-label">{d.output}</span>
                <div class="cv-area">
                  <span class="cv-progress">
                    <span class="cv-row"><span>{d.convert.converting}</span><span class="cv-pct">42 %</span></span>
                    <span class="cv-bar"><span></span></span>
                    <span class="cv-gif">{d.convert.outputFixed}</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <aside class="panel" aria-hidden="true">
            <div class="p-scroll">
              <div class="f-fixed"><span class="f-fixed-label">{d.output}</span><span class="f-fixed-box">{d.convert.outputFixed}</span></div>
              <DemoField label={d.convert.frameRate} opts={d.convert.fpsOpts} active={3} />
              <DemoField label={d.convert.width} opts={d.convert.widthOpts} active={2} hint={d.convert.widthHint} />
              <DemoField label={d.quality} opts={d.qualityOpts} active={1} secondary />
            </div>
            <div class="p-foot">
              <span class="p-btn p-btn-busy"><svg viewBox="0 0 24 24" set:html={icon.convert} />{d.convert.button}</span>
              <span class="p-kbd">Ctrl + Enter</span>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
  <figcaption>
    <span class="demo-hint"><span class="demo-pulse" aria-hidden="true"></span>{d.hint}</span>
    <span class="muted">{d.note}</span>
  </figcaption>
</figure>

<style>
  .demo { margin: 0; perspective: 1800px; container: demo / inline-size; }

  /* The app's dark theme (src/styles/tokens.css), scoped to the window. */
  .app {
    --d-bg: #0a0e15; --d-bg-sunken: #070a10; --d-surface: #0f141c; --d-surface-2: #141a24; --d-surface-3: #1a212c;
    --d-border: rgb(160 195 235 / 0.07); --d-border-strong: rgb(160 195 235 / 0.12);
    --d-text: #e9edf3; --d-text-2: #a2abb8; --d-text-3: #6a7484;
    --d-accent: #3dd6d0; --d-accent-ink: #032321; --d-accent-soft: rgb(61 214 208 / 0.11); --d-accent-line: rgb(61 214 208 / 0.45);
    --d-success: #52d394;
    --d-ease: cubic-bezier(0.22, 1, 0.36, 1);
    display: flex; flex-direction: column;
    aspect-ratio: 1320 / 840;
    border-radius: 12px; overflow: hidden;
    background: var(--d-bg); color: var(--d-text);
    border: 1px solid var(--line-strong);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.75), 0 0 0 1px rgb(0 0 0 / 0.4);
    font: 13px/1.45 var(--font); letter-spacing: -0.003em;
    text-align: left; user-select: none;
    transform-origin: 50% 0;
    transition: transform 1.2s var(--ease), box-shadow 0.4s;
  }
  .js .demo:not(.in) .app { transform: rotateX(9deg) scale(0.97); }
  .app:hover { box-shadow: 0 48px 90px -30px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(61 214 208 / 0.18); }
  .app svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sb-i, .card, .cc-btn { font: inherit; color: inherit; text-align: inherit; cursor: pointer; }

  /* Title bar */
  .tb { display: flex; align-items: center; justify-content: space-between; height: 44px; flex: none; padding-left: 16px; border-bottom: 1px solid var(--d-border); }
  .tb-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--d-text-2); font-size: 13px; font-weight: 500; }
  .tb-brand svg { color: var(--d-text); }
  .tb-sep { width: 1px; height: 14px; background: var(--d-border-strong); }
  .tb-right { display: flex; align-items: center; gap: 10px; height: 100%; color: var(--d-text-3); }
  .tb-status { display: inline-flex; align-items: center; gap: 7px; color: var(--d-text-3); font-size: 12px; }
  .tb-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--d-success); box-shadow: 0 0 6px var(--d-success); }
  .tb-line { width: 1px; height: 16px; background: var(--d-border-strong); }
  .tb-icon { width: 15px; height: 15px; margin: 0 4px; }
  .tb-win { display: grid; place-items: center; width: 46px; height: 100%; }
  .tb-win svg { width: 14px; height: 14px; stroke-width: 1.4; }

  .body { position: relative; display: flex; flex: 1; min-height: 0; }

  /* Sidebar */
  .sb {
    display: flex; flex-direction: column; width: 200px; flex: none; padding: 12px 10px;
    border-right: 1px solid var(--d-border);
    background: linear-gradient(180deg, color-mix(in srgb, var(--d-surface) 60%, transparent), color-mix(in srgb, var(--d-bg) 35%, transparent));
  }
  .sb-group { position: relative; display: flex; flex-direction: column; gap: 3px; }
  .sb-secondary { display: flex; flex-direction: column; gap: 3px; }
  .sb-div { height: 1px; margin: 12px 10px; background: linear-gradient(90deg, var(--d-border-strong), transparent); }
  .sb-spacer { flex: 1; }
  .sb-i {
    position: relative; z-index: 1; display: flex; align-items: center; gap: 11px; width: 100%; height: 36px; padding: 0 11px;
    border: 0; border-radius: 8px; background: none; color: var(--d-text-2); font-weight: 500; white-space: nowrap;
    transition: background-color 0.18s var(--d-ease), color 0.18s var(--d-ease);
  }
  button.sb-i:hover:not([aria-selected="true"]) { background: color-mix(in srgb, var(--d-surface-2) 70%, transparent); color: var(--d-text); }
  button.sb-i:hover:not([aria-selected="true"]) .sb-icon { color: var(--d-text-2); transform: translateX(1px); }
  .sb-i[aria-selected="true"] { color: color-mix(in srgb, var(--d-accent) 80%, var(--d-text)); }
  .sb-icon { width: 17px; height: 17px; flex: none; color: var(--d-text-3); transition: color 0.18s var(--d-ease), transform 0.18s var(--d-ease); }
  .sb-i[aria-selected="true"] .sb-icon { color: var(--d-accent); }
  .sb-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .sb-badge {
    min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--d-surface-3);
    color: var(--d-text-2); font-size: 11px; line-height: 18px; text-align: center; font-variant-numeric: tabular-nums;
  }
  .sb-static { cursor: default; }
  .sb-support { color: var(--d-text-3); font-size: 12.5px; }
  .sb-version { padding: 6px 11px 0; color: var(--d-text-3); font-size: 11px; font-variant-numeric: tabular-nums; }
  /* One highlight that glides to the selected section, like the app's. Without JS the
     selected button carries the same look itself. */
  .sb-hl {
    position: absolute; left: 0; right: 0; top: 0; height: 36px; border-radius: 8px; opacity: 0; pointer-events: none;
    background: linear-gradient(90deg, color-mix(in srgb, var(--d-accent) 7%, var(--d-surface-3)), var(--d-surface-2));
    box-shadow: 0 0 0 1px var(--d-border) inset;
