<script>
  // Switches the demo between Home, Image & GIF, Clip and Convert (WAI-ARIA tabs pattern).
  const demo = document.querySelector<HTMLElement>("[data-demo]");
  if (demo) {
    const app = demo.querySelector<HTMLElement>(".app")!;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const hl = demo.querySelector<HTMLElement>(".sb-hl")!;
    const current = () => tabs.find((t) => t.getAttribute("aria-selected") === "true") ?? tabs[0];
    const place = (tab: HTMLButtonElement) => {
      hl.style.transform = `translateY(${tab.offsetTop}px)`;
      hl.style.height = `${tab.offsetHeight}px`;
    };

    const select = (view: string, focus = false) => {
      const tab = tabs.find((t) => t.dataset.view === view);
      if (!tab || tab === current()) return;
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!)!;
        panel.hidden = !on;
        if (on) {
          panel.classList.remove("enter");
          void panel.offsetWidth; // restart the animation
          panel.classList.add("enter");
        }
      }
      place(tab);
      if (focus) tab.focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t.dataset.view!));
      t.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : e.key === "ArrowUp" || e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length].dataset.view!, true);
      });
    });
    demo.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((b) => b.addEventListener("click", () => select(b.dataset.go!)));

    // Place the highlight without a glide, then let it glide from now on.
    hl.style.transition = "none";
    place(current());
    void hl.offsetWidth;
    hl.style.transition = "";
    app.classList.add("ready");
    new ResizeObserver(() => place(current())).observe(app);

    // Flatten the window once it is on screen.
    new IntersectionObserver(([e], io) => {
      if (e.isIntersecting) {
        demo.classList.add("in");
        io.disconnect();
      }
    }, { threshold: 0.25 }).observe(demo);
  }
</script>
