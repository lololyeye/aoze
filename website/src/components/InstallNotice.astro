---
// Shown when someone clicks a link marked data-installer. The installer is not code-signed, so
// Windows will warn about it: this explains why, in plain words, before the download starts.
// The download only starts on "OK". Without JavaScript, the link downloads directly.
import { legal } from "../data/legal";
import { pageHref } from "../lib/site";
import type { Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const fr = lang === "fr";
const email = legal.privacyEmail ?? legal.contactEmail;
const DISCORD = "1fi";

const c = fr
  ? {
      title: "Avant d'installer Aoze",
      lead: "Windows va sûrement afficher un avertissement pendant l'installation. C'est normal, et voici pourquoi.",
      whyTitle: "Pourquoi cet avertissement ?",
      why: "Pour que Windows reconnaisse l'auteur d'un logiciel, il faut acheter un certificat de « signature de code ». Aoze est gratuit et n'en a pas encore. Windows ne sait donc pas qui l'a publié, et il prévient par précaution. Cela ne veut pas dire que le fichier est dangereux, seulement que Windows ne peut pas encore vérifier son auteur.",
      seeTitle: "Ce que vous allez peut-être voir",
      see: [
        ["Dans votre navigateur", "un message comme « ce fichier n'est pas couramment téléchargé ». Choisissez « Conserver »."],
        ["En ouvrant le fichier", "un écran bleu « Windows a protégé votre ordinateur », avec « Éditeur inconnu ». Cliquez sur « Informations complémentaires », puis sur « Exécuter quand même »."],
        ["Plus rarement, votre antivirus", "peut bloquer le fichier. Ne désactivez pas votre antivirus : écrivez-moi, on regarde ensemble."],
      ],
      trustTitle: "Ce qui est vérifiable",
      trust: [
        "Le fichier vient directement de la page GitHub officielle d'Aoze.",
        "Le code source est public (licence MIT) : tout le monde peut le lire.",
        "Aoze ne collecte aucune donnée personnelle et ne demande pas de compte. Vos droits (RGPD) sont détaillés dans la",
        "L'installation ne demande pas de droits administrateur, et Aoze se désinstalle depuis Paramètres → Applications.",
      ],
      privacy: "politique de confidentialité",
      helpTitle: "Un doute ? Écrivez-moi avant d'installer.",
      help: "Pour toute question, ou pour être guidé pas à pas pendant l'installation, je réponds avec plaisir.",
      mail: "E-mail",
      copy: "Copier",
      copied: "Copié",
      ok: "D'accord, j'ai compris, merci !",
      cancel: "Annuler",
      close: "Fermer",
    }
  : {
      title: "Before you install Aoze",
      lead: "Windows will most likely show a warning during installation. That's normal, and here is why.",
      whyTitle: "Why the warning?",
      why: "For Windows to recognise who made a program, the author has to buy a “code signing” certificate. Aoze is free and doesn't have one yet. So Windows doesn't know who published it, and warns you just in case. It doesn't mean the file is dangerous, only that Windows can't check its author yet.",
      seeTitle: "What you may see",
      see: [
        ["In your browser", "a message like “this file isn't commonly downloaded”. Choose “Keep”."],
        ["When you open the file", "a blue screen saying “Windows protected your PC”, with “Unknown publisher”. Click “More info”, then “Run anyway”."],
        ["More rarely, your antivirus", "may block the file. Don't turn your antivirus off: write to me and we'll look at it together."],
      ],
      trustTitle: "What you can check",
      trust: [
        "The file comes straight from Aoze's official GitHub page.",
        "The source code is public (MIT License): anyone can read it.",
        "Aoze collects no personal data and needs no account. Your rights (GDPR) are explained in the",
        "Installing needs no administrator rights, and Aoze uninstalls from Settings → Apps.",
      ],
      privacy: "privacy policy",
      helpTitle: "Any doubt? Write to me before installing.",
      help: "For any question, or to be guided step by step through the install, I'm happy to help.",
      mail: "Email",
      copy: "Copy",
      copied: "Copied",
      ok: "OK, got it, thanks!",
      cancel: "Cancel",
      close: "Close",
    };
---
<dialog class="install-notice" aria-labelledby="in-title" data-install-notice>
  <div class="in-body" tabindex="-1" autofocus>
    <button class="in-close" type="button" value="cancel" aria-label={c.close} data-in-cancel>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <span class="eyebrow">{fr ? "Téléchargement" : "Download"}</span>
    <h2 id="in-title">{c.title}</h2>
    <p class="in-lead">{c.lead}</p>

    <h3>{c.whyTitle}</h3>
    <p>{c.why}</p>

    <h3>{c.seeTitle}</h3>
    <ol class="in-steps">
      {c.see.map(([k, v]) => <li><strong>{k}</strong>{fr ? " : " : ": "}{v}</li>)}
    </ol>

    <h3>{c.trustTitle}</h3>
    <ul class="in-trust">
      {c.trust.map((s, i) => <li>{s}{i === 2 && <> <a class="link" href={pageHref(lang, "privacy/")}>{c.privacy}</a>.</>}</li>)}
    </ul>

    <div class="in-help">
      <p class="in-help-title">{c.helpTitle}</p>
      <p>{c.help}</p>
      <dl>
        {email && <div><dt>{c.mail}</dt><dd><a class="link" href={`mailto:${email}`}>{email}</a></dd></div>}
        <div><dt>Discord</dt><dd><span class="mono">{DISCORD}</span> <button class="in-copy" type="button" data-copy-text={DISCORD} data-copied={c.copied}>{c.copy}</button></dd></div>
      </dl>
    </div>
  </div>
  <div class="in-actions">
    <button class="btn btn-ghost" type="button" data-in-cancel>{c.cancel}</button>
    <button class="btn btn-primary" type="button" data-in-ok>{c.ok}</button>
  </div>
</dialog>

<script>
  import { DOWNLOAD_PATH } from "../lib/site";

  // Every installer link opens the notice first; "OK" starts the download.
  const dialog = document.querySelector<HTMLDialogElement>("[data-install-notice]");
  if (dialog && typeof dialog.showModal === "function") {
    let url = "";
    let opener: HTMLElement | null = null;
    document.addEventListener("click", (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>("a[data-installer]");
      if (!a || e.button !== 0) return;
      e.preventDefault();
      url = a.href; // read on click: ReleaseSync may have updated it
      opener = a;
      dialog.showModal();
      dialog.querySelector<HTMLElement>(".in-body")!.scrollTop = 0;
    });
    const close = () => dialog.close();
    dialog.addEventListener("close", () => opener?.focus()); // also after Escape
    dialog.querySelectorAll("[data-in-cancel]").forEach((b) => b.addEventListener("click", close));
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close(); // click on the backdrop
    });
    dialog.querySelector("[data-in-ok]")!.addEventListener("click", () => {
      close();
      const target = new URL(url, location.href);
      if (target.origin === location.origin && target.pathname.startsWith(DOWNLOAD_PATH)) location.href = target.href;
    });
    dialog.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((b) =>
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copyText!);
          const label = b.textContent;
          b.textContent = b.dataset.copied!;
          setTimeout(() => (b.textContent = label), 1600);
        } catch {}
      }),
    );
  }
</script>

<style>
  .install-notice {
    width: min(640px, calc(100% - 32px)); max-height: min(88vh, 860px);
    padding: 0; border: 1px solid var(--line-strong); border-radius: 18px;
    background: var(--surface); color: var(--text);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.55);
    flex-direction: column; overflow: hidden;
  }
  .install-notice[open] { display: flex; }
  .install-notice::backdrop { background: rgb(4 7 12 / 0.72); backdrop-filter: blur(4px); }
  @media (prefers-reduced-motion: no-preference) {
    .install-notice[open] { animation: in-pop 0.28s var(--ease); }
    @keyframes in-pop { from { opacity: 0; transform: translateY(12px) scale(0.98); } }
  }
  .in-body:focus { outline: none; }
  .in-body {
    position: relative; overflow-y: auto; padding: 32px 32px 8px; font-size: 16px;
  }
  /* Chrome and Edge ignore the ::-webkit-scrollbar rules below once these are set, so Firefox only. */
  @supports not selector(::-webkit-scrollbar) {
    .in-body { scrollbar-width: thin; scrollbar-color: rgb(160 195 235 / 0.22) transparent; }
  }
  /* A slim rail in the site's colours, kept off the rounded corners; teal while in use. */
  .in-body::-webkit-scrollbar { width: 10px; }
  .in-body::-webkit-scrollbar-track { background: transparent; margin-block: 14px; }
  .in-body::-webkit-scrollbar-thumb {
    background: rgb(160 195 235 / 0.18) padding-box; border: 3px solid transparent; border-radius: 10px;
  }
  .in-body::-webkit-scrollbar-thumb:hover { background-color: rgb(61 214 208 / 0.55); }
  .in-body::-webkit-scrollbar-thumb:active { background-color: var(--accent); }
  .in-body::-webkit-scrollbar-button { display: none; height: 0; }
  .in-close {
    position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; display: grid; place-items: center;
    border: 0; border-radius: 8px; background: none; color: var(--text-2); cursor: pointer;
  }
  .in-close:hover { color: var(--text); background: rgb(160 195 235 / 0.06); }
  .in-close svg { width: 20px; height: 20px; }
  .install-notice h2 { margin-top: 14px; font-size: clamp(1.5rem, 4vw, 1.9rem); padding-right: 32px; }
  .in-lead { margin-top: 10px; color: var(--text-2); font-size: 1.05rem; }
  .install-notice h3 { margin: 24px 0 8px; font-size: 1.02rem; font-weight: 620; letter-spacing: -0.01em; }
  .install-notice p { color: var(--text-2); }
  .in-steps { margin: 0; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 10px; }
  .in-steps li { counter-increment: s; position: relative; padding-left: 36px; color: var(--text-2); }
  .in-steps li::before {
    content: counter(s); position: absolute; left: 0; top: 1px; width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center; font: 600 13px/1 var(--font);
    background: var(--accent-soft); color: var(--accent);
  }
  .in-steps strong, .in-trust strong { color: var(--text); font-weight: 600; }
  .in-trust { display: grid; gap: 8px; }
  .in-trust li { position: relative; padding-left: 26px; color: var(--text-2); }
  .in-trust li::before {
    content: ""; position: absolute; left: 2px; top: 0.45em; width: 12px; height: 7px;
    border-left: 2px solid var(--accent); border-bottom: 2px solid var(--accent); transform: rotate(-45deg);
  }
  .in-help {
    margin: 24px 0 16px; padding: 18px 20px; border-radius: var(--radius);
    background: var(--accent-soft); border: 1px solid rgb(61 214 208 / 0.22);
  }
  .in-help-title { color: var(--text) !important; font-weight: 600; }
  .in-help > p + p { margin-top: 4px; }
  .in-help dl { margin: 12px 0 0; display: grid; gap: 6px; }
  .in-help dl div { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
  .in-help dt { min-width: 64px; color: var(--text-3); font-size: 14px; }
  .in-help dd { margin: 0; overflow-wrap: anywhere; }
  .in-copy {
    margin-left: 6px; padding: 3px 10px; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--line-strong); background: none; color: var(--text-2); font: 500 13px/1.4 var(--font);
  }
  .in-copy:hover { color: var(--text); }
  .in-actions {
    display: flex; justify-content: flex-end; gap: 10px; flex-wrap: wrap;
    padding: 16px 32px 24px; border-top: 1px solid var(--line); background: var(--surface);
  }
  @media (max-width: 560px) {
    .in-body { padding: 24px 20px 4px; }
    .in-actions { padding: 14px 20px 20px; flex-direction: column-reverse; }
    .in-actions .btn { width: 100%; justify-content: center; }
  }
</style>
