---
// One setting of the demo's right panel, drawn like the app's Field + Segmented (or chips).
// Purely visual: the options are spans, not buttons, so nothing pretends to be clickable.
interface Props {
  label?: string;
  opts: string[];
  active: number;
  aside?: string;
  hint?: string;
  chips?: boolean;
  /** Left out on phones, where the panel only keeps the main settings. */
  secondary?: boolean;
}
const { label, opts, active, aside, hint, chips = false, secondary = false } = Astro.props;
---
<div class:list={["f", secondary && "f-secondary"]}>
  {label && (
    <div class="f-head">
      <span class="f-label">{label}<span class="f-q" aria-hidden="true">?</span></span>
      {aside && <span class="f-aside">{aside}</span>}
    </div>
  )}
  <div class={chips ? "chips" : "seg"}>
    {opts.map((o, i) => <span class:list={[chips ? "chip" : "seg-i", i === active && "on"]}>{o}</span>)}
  </div>
  {hint && <p class="f-hint">{hint}</p>}
</div>

<style>
  .f { display: grid; gap: 7px; }
  .f-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .f-label { display: inline-flex; align-items: center; gap: 6px; color: var(--d-text); font-weight: 500; font-size: 12.5px; }
  .f-q {
    display: inline-grid; place-items: center; width: 13px; height: 13px; border-radius: 50%;
    background: var(--d-surface-3); color: var(--d-text-3); font-size: 9px; font-weight: 600;
  }
  .f-aside { color: var(--d-text-3); font-size: 11.5px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .f-hint { margin: 0; color: var(--d-text-3); font-size: 11.5px; line-height: 1.45; }

  .seg {
    display: flex; padding: 3px; gap: 2px; border-radius: 8px;
    background: var(--d-bg-sunken); border: 1px solid var(--d-border);
  }
  .seg-i {
    flex: 1; min-width: 0; padding: 6px 4px; border-radius: 6px;
    color: var(--d-text-2); font-size: 12px; font-weight: 500; text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .seg-i.on { background: var(--d-surface-3); color: var(--d-text); font-weight: 600; box-shadow: inset 0 0 0 1px var(--d-border-strong); }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    padding: 5px 10px; border-radius: 999px; border: 1px solid var(--d-border-strong);
    color: var(--d-text-2); font-size: 12px; font-weight: 500; white-space: nowrap;
  }
  .chip.on { color: var(--d-accent); background: var(--d-accent-soft); border-color: var(--d-accent-line); }

  @container demo (max-width: 680px) {
    .f-secondary { display: none; }
  }
</style>
