---
// One 404 for both languages (GitHub Pages serves a single 404.html), so it says it in both.
import Base from "../layouts/Base.astro";
import { pageHref } from "../lib/site";
import { ui } from "../i18n/ui";

const { en, fr } = { en: ui.en.notFound, fr: ui.fr.notFound };
---
<Base lang="en" path={null} title={`${en.title} / ${fr.title}`}>
  <section class="nf">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>{en.h1}</h1>
      <p class="muted">{en.text}</p>
      <p class="fr" lang="fr">{fr.h1} {fr.text}</p>
      <div class="actions">
        <a class="btn btn-primary" href={pageHref("en")}>{en.home}</a>
        <a class="btn btn-ghost" href={pageHref("fr")} lang="fr">{fr.home}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; display: grid; align-items: center; }
  .nf .wrap { display: grid; gap: 18px; justify-items: start; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .fr { color: var(--text-3); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
