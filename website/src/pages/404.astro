---
import Base from "../layouts/Base.astro";
import { href } from "../lib/site";
---
<Base title="Page not found">
  <section class="nf">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>This page doesn't exist.</h1>
      <p class="muted">The link may be old, or mistyped.</p>
      <div class="actions">
        <a class="btn btn-primary" href={href()}>Go to the home page</a>
        <a class="btn btn-ghost" href={href("download/")}>Download Aoze</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; display: grid; align-items: center; }
  .nf .wrap { display: grid; gap: 18px; justify-items: start; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
