---
import Base from "../layouts/Base.astro";
import Compare from "../components/Compare.astro";
import { latestRelease, version, formatSize } from "../lib/release";
import { GITHUB_URL, RELEASES_URL, LICENSE_URL, ISSUES_URL, README_URL, VIDEO_ENGINE_URL, href } from "../lib/site";

const release = await latestRelease();
const v = version(release);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Aoze",
  description: "Enlarge, clean up and compress images, GIFs and clips locally on Windows.",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: v,
  downloadUrl: release.asset.url,
  fileSize: formatSize(release.asset.size),
  license: LICENSE_URL,
  url: new URL(href(), Astro.site).toString(),
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---
<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="eyebrow release-tag reveal" href={release.url}>Aoze {v} for Windows</a>
        <h1 class="reveal" data-delay="1">Make your media look better.</h1>
        <p class="lead reveal" data-delay="2">
          Aoze enlarges, cleans up and compresses images, GIFs and clips, right on your PC.
          Open a file, pick a preset, done.
        </p>
        <div class="actions reveal" data-delay="3">
          <a class="btn btn-primary btn-lg" href={href("download/")}>
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" /></svg>
            Download for Windows
          </a>
          <a class="btn btn-ghost btn-lg" href={GITHUB_URL}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
            View on GitHub
          </a>
        </div>
        <p class="meta reveal" data-delay="3">
          <span>Free</span><span>Open source</span><span>Windows 10 / 11 · x64</span>
        </p>
      </div>

      <figure class="window" data-shots>
        <div class="window-frame">
          <img class="shot is-active" data-shot="image" src={href("shots/app-image.webp")}
               srcset={`${href("shots/app-image-760.webp")} 760w, ${href("shots/app-image.webp")} 1320w`}
               sizes="(max-width: 1000px) 100vw, 1160px" width="1320" height="840"
               alt="Aoze's Image & GIF workspace with a small JPEG loaded, set to enlarge 4× with noise reduction." fetchpriority="high" />
          <img class="shot" data-shot="home" src={href("shots/app-home.webp")}
               srcset={`${href("shots/app-home-760.webp")} 760w, ${href("shots/app-home.webp")} 1320w`}
               sizes="(max-width: 1000px) 100vw, 1160px" width="1320" height="840"
               alt="Aoze's home screen: choose Image / GIF, Clip / Video or Convert." loading="lazy" />
        </div>
        <figcaption>
          <div class="shot-tabs" role="group" aria-label="Screenshot">
            <button type="button" aria-pressed="true" data-show="image">Image &amp; GIF</button>
            <button type="button" aria-pressed="false" data-show="home">Home</button>
          </div>
          <span class="muted">Aoze {v} on Windows 11. Real screenshots.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Before / after -->
  <section id="compare" class="compare-section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Before / after</span>
        <h2>See the difference.</h2>
        <p>Real output from the engines inside Aoze, not a mock-up. Drag the line.</p>
      </div>

      <div class="demo-tabs reveal" role="tablist" aria-label="Demo">
        <button role="tab" id="tab-image" aria-controls="panel-image" aria-selected="true">Image</button>
        <button role="tab" id="tab-motion" aria-controls="panel-motion" aria-selected="false" tabindex="-1">Motion</button>
      </div>

      <div class="demo-panel reveal" id="panel-image" role="tabpanel" aria-labelledby="tab-image">
        <Compare
          before={href("demo/image-original.jpg")}
          after={href("demo/image-enhanced.webp")}
          width={1600} height={1000}
          alt="Illustration of a lake at dusk."
        />
        <dl class="demo-facts">
          <div><dt>Original</dt><dd>400 × 250 JPEG, 5 KB, shown enlarged</dd></div>
          <div><dt>Aoze</dt><dd>Anime · 4× · noise reduction High → 1600 × 1000</dd></div>
        </dl>
      </div>

      <div class="demo-panel" id="panel-motion" role="tabpanel" aria-labelledby="tab-motion" hidden>
        <div class="motion">
          <div class="motion-labels" aria-hidden="true"><span>24 FPS · original</span><span>60 FPS · Smooth Motion</span></div>
          <video data-autoplay muted loop playsinline preload="none" width="1280" height="360"
                 poster={href("demo/motion-poster.jpg")}
                 data-wide={href("demo/motion-24-60.mp4")}
                 data-tall={href("demo/motion-24-60-v.mp4")} data-tall-poster={href("demo/motion-poster-v.jpg")}
                 aria-label="The same camera move at 24 frames per second, then at 60 with Smooth Motion."></video>
          <button class="motion-toggle" type="button" aria-pressed="false">Pause</button>
        </div>
        <dl class="demo-facts">
          <div><dt>24 FPS</dt><dd>The source, each frame repeated</dd></div>
          <div><dt>60 FPS</dt><dd>New in-between frames from Smooth Motion (RIFE v4.6)</dd></div>
        </dl>
      </div>
      <p class="demo-note">The test illustration was drawn for this page. Both demos are generated with Aoze's own engines by
        <a class="link" href={`${GITHUB_URL}/tree/main/website/demo`}>a script in the repository</a>.</p>
    </div>
  </section>

  <hr class="divider" />

  <!-- Features -->
  <section id="features">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Features</span>
        <h2>What it does.</h2>
        <p>Three workspaces. Each one shows only the options that make sense for your file.</p>
      </div>

      <div class="features">
        <article class="feature reveal">
          <h3>Image &amp; GIF</h3>
          <ul>
            <li>Upscale <span class="mono">1.6× · 2× · 4× · 8×</span></li>
            <li>Noise reduction and clean-up</li>
            <li>Compression, with an exact size limit</li>
            <li>GIFs keep their timing and transparency</li>
            <li>Discord sizes: avatar and banners</li>
          </ul>
          <p class="formats mono">PNG · JPG · WebP · BMP · TIFF · GIF</p>
        </article>
        <article class="feature reveal" data-delay="1">
          <h3>Clips</h3>
          <ul>
            <li>Enhancement: Sharpen or Clean-up</li>
            <li>Upscale <span class="mono">up to 4×</span></li>
            <li>Smooth Motion <span class="mono">→ 60 / 120 FPS</span></li>
            <li>Frame rate control</li>
            <li>HDR and Motion blur</li>
            <li>Compression, with the audio kept</li>
          </ul>
          <p class="formats mono">MP4 · MOV · MKV · WebM · AVI</p>
        </article>
        <article class="feature reveal" data-delay="2">
          <h3>Convert</h3>
          <ul>
            <li>Clip <span class="mono">→</span> GIF</li>
            <li>GIF <span class="mono">→</span> MP4</li>
            <li>GIF <span class="mono">→</span> PNG frames</li>
            <li>Images <span class="mono">→</span> GIF</li>
          </ul>
          <p class="formats mono">FPS · width · quality · size limit</p>
        </article>
      </div>
      <p class="more reveal">Every option is explained in the <a class="link" href={README_URL}>README</a>, and the video engine in
        <a class="link" href={VIDEO_ENGINE_URL}>its own notes</a>.</p>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="how">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>Four steps. That's it.</h2>
      </div>
      <ol class="steps">
        <li class="reveal"><span class="mono">01</span><h3>Import</h3><p>Drop files anywhere in the window. Aoze opens the right workspace.</p></li>
        <li class="reveal" data-delay="1"><span class="mono">02</span><h3>Configure</h3><p>Pick a preset (Anime, Edit, High quality, Small file) or change only what you need.</p></li>
        <li class="reveal" data-delay="2"><span class="mono">03</span><h3>Process</h3><p>Real progress and time left. Pause or cancel at any moment.</p></li>
        <li class="reveal" data-delay="3"><span class="mono">04</span><h3>Done</h3><p>The output folder opens, with what changed: size, frames, FPS.</p></li>
      </ol>
    </div>
  </section>

  <hr class="divider" />

  <!-- Editors -->
  <section id="editors" class="editors">
    <div class="wrap editors-grid">
      <div>
        <div class="section-head reveal">
          <span class="eyebrow">For edits</span>
          <h2>Made for editors.</h2>
          <p class="trio">Sharper clips.<br />Smoother motion.<br />Better colors.</p>
        </div>
        <p class="fps reveal" aria-label="24 FPS to 60 FPS"><span>24</span><span class="to" aria-hidden="true"></span><span>60</span><small>FPS</small></p>
        <ul class="points">
          <li class="reveal"><h3>Smooth Motion</h3><p>Real in-between frames, up to 120 FPS. It never blends two shots across a cut.</p></li>
          <li class="reveal"><h3>Motion blur</h3><p>Made from the motion itself, like a camera shutter. Low, Medium or High.</p></li>
          <li class="reveal"><h3>HDR</h3><p>Keeps HDR sources in HDR, or rebuilds SDR clips as HDR10 for HDR screens.</p></li>
          <li class="reveal"><h3>Look</h3><p>Exposure, contrast, saturation and sharpness. At zero, nothing changes.</p></li>
          <li class="reveal"><h3>The Edit preset</h3><p>Sharper, 60 FPS, a little motion blur and a touch of contrast. One click.</p></li>
        </ul>
      </div>
      <figure class="panel-shot reveal" data-delay="1">
        <img src={href("shots/app-clip-panel.webp")} width="316" height="796" loading="lazy" decoding="async"
             alt="Aoze's Clip settings: Smooth Motion 24 to 60 FPS, motion blur Low, HDR Enhanced." />
        <figcaption class="muted">The Clip panel, set for an edit.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Performance -->
  <section id="performance" class="perf">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Performance</span>
        <h2>Fast by design.</h2>
        <p>Aoze reads your hardware and adapts to it, from a small laptop to a gaming PC.</p>
      </div>
      <div class="perf-grid">
        <div class="reveal"><h3>GPU acceleration</h3><p>Works on any Vulkan GPU: NVIDIA, AMD, Intel, integrated. Without one, it falls back to the CPU. Slower, but it works.</p></div>
        <div class="reveal" data-delay="1"><h3>Hardware encoding</h3><p>At startup Aoze tests NVENC, AMF and Quick Sync, and uses the first one that works on your PC.</p></div>
        <div class="reveal" data-delay="2"><h3>Tuned to your PC</h3><p>Tile size, threads and memory use are chosen from your graphics card and free memory, before every run.</p></div>
        <div class="reveal" data-delay="3"><h3>Leaves room for you</h3><p>In Balanced mode the engines run at lower priority, so your PC stays usable while Aoze works.</p></div>
      </div>
    </div>
  </section>

  <!-- Local -->
  <section id="local" class="local">
    <div class="wrap local-inner reveal">
      <svg class="local-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="6" y="9" width="36" height="24" rx="3" /><path d="M17 39h14M24 33v6" stroke-linecap="round" />
        <path d="M19 21l4 4 7-8" stroke="var(--accent)" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <h2>Your files stay on your PC.</h2>
      <p>Aoze processes everything locally. No upload, no account, no telemetry: the app itself makes no network requests.</p>
      <p class="fine">If Windows doesn't have Microsoft's WebView2 runtime yet, the installer downloads it. Links such as GitHub open in your browser.</p>
    </div>
  </section>

  <hr class="divider" />

  <!-- Open source -->
  <section id="open-source" class="oss">
    <div class="wrap oss-grid">
      <div class="section-head reveal">
        <span class="eyebrow">MIT License</span>
        <h2>Open source.</h2>
        <p>Aoze is MIT licensed. The code, the releases and the issues all live on GitHub.</p>
        <div class="actions">
          <a class="btn btn-ghost" href={GITHUB_URL}>View on GitHub</a>
          <a class="btn btn-ghost" href={RELEASES_URL}>GitHub Releases</a>
        </div>
      </div>
      <dl class="oss-list reveal" data-delay="1">
        <div><dt>Repository</dt><dd><a class="link" href={GITHUB_URL}>github.com/lololyeye/aoze</a></dd></div>
        <div><dt>License</dt><dd><a class="link" href={LICENSE_URL}>MIT</a></dd></div>
        <div><dt>Contribute</dt><dd>Report a bug or suggest an idea in the <a class="link" href={ISSUES_URL}>issues</a>. Pull requests are welcome.</dd></div>
        <div><dt>Built with</dt><dd>Tauri 2, Rust, React, TypeScript</dd></div>
        <div><dt>Engines</dt><dd>waifu2x, FFmpeg, RIFE, Real-ESRGAN. <a class="link" href={href("credits/")}>Credits and licenses</a></dd></div>
      </dl>
    </div>
  </section>

  <!-- Final call -->
  <section class="final">
    <div class="wrap final-inner reveal">
      <h2>Try it on your own files.</h2>
      <a class="btn btn-primary btn-lg" href={release.asset.url}>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" /></svg>
        Download Aoze {v}
      </a>
      <p class="muted">Windows 10 / 11 · x64 · {formatSize(release.asset.size)} · <a class="link" href={href("download/")}>Checksum and release notes</a></p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 8vw, 96px) clamp(56px, 8vw, 104px); overflow: hidden; }
  .hero-grid { display: grid; gap: clamp(40px, 6vw, 72px); }
  .hero-copy { display: grid; gap: 22px; justify-items: start; max-width: 760px; }
  .release-tag { text-decoration: none; transition: color 0.2s; }
  .release-tag:hover { color: var(--text); }
  h1 { font-size: clamp(2.6rem, 7vw, 5rem); letter-spacing: -0.035em; font-weight: 640; }
  .lead { color: var(--text-2); font-size: clamp(1.08rem, 1.6vw, 1.25rem); max-width: 34em; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .meta { display: flex; flex-wrap: wrap; row-gap: 6px; color: var(--text-3); font-size: 14px; }
  .meta span + span::before { content: "·"; margin: 0 12px; }

  .window { margin: 0; perspective: 1800px; }
  .window-frame {
    position: relative; aspect-ratio: 1320 / 840; border-radius: 12px; overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.75), 0 0 0 1px rgb(0 0 0 / 0.4);
    transform-origin: 50% 0;
    transition: transform 1.2s var(--ease), box-shadow 0.4s;
  }
  .js .window:not(.in) .window-frame { transform: rotateX(9deg) scale(0.97); }
  .window-frame:hover { box-shadow: 0 48px 90px -30px rgb(0 0 0 / 0.8), 0 0 0 1px rgb(61 214 208 / 0.18); }
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.45s var(--ease); }
  .shot.is-active { opacity: 1; position: relative; }
  .window figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; font-size: 14px; }
  .shot-tabs { display: inline-flex; padding: 3px; border-radius: 9px; background: var(--surface); border: 1px solid var(--line); }
  .shot-tabs button, .demo-tabs button {
    border: 0; background: none; color: var(--text-2); padding: 7px 14px; border-radius: 7px;
    font: 500 14px/1 var(--font); cursor: pointer; transition: color 0.2s, background-color 0.2s;
  }
  .shot-tabs button:hover, .demo-tabs button:hover { color: var(--text); }
  .shot-tabs button[aria-pressed="true"], .demo-tabs button[aria-selected="true"] { background: var(--surface-2); color: var(--text); box-shadow: inset 0 0 0 1px var(--line-strong); }
  @media (prefers-reduced-motion: reduce) {
    .js .window:not(.in) .window-frame { transform: none; }
  }

  /* Before / after */
  .demo-tabs { display: inline-flex; padding: 3px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); margin-bottom: 20px; }
  .demo-tabs button { padding: 9px 18px; font-size: 15px; }
  .demo-facts { display: flex; flex-wrap: wrap; gap: 10px 40px; margin: 18px 0 0; font-size: 15px; }
  .demo-facts div { display: flex; gap: 12px; }
  .demo-facts dt { color: var(--text-3); font-family: var(--mono); font-size: 13px; padding-top: 2px; white-space: nowrap; }
  .demo-facts dd { margin: 0; color: var(--text-2); }
  .demo-note { margin-top: 28px; color: var(--text-3); font-size: 14px; }
  .motion { position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--bg-deep); }
  .motion video { width: 100%; aspect-ratio: 1280 / 360; }
  .motion::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; margin-left: -1px; background: var(--accent); }
  .motion-labels { position: absolute; inset: 14px 14px auto; display: flex; justify-content: space-between; z-index: 1; pointer-events: none; }
  .motion-labels span { padding: 5px 10px; border-radius: 6px; background: rgb(7 10 16 / 0.72); font: 500 12px/1.2 var(--mono); }
  .motion-toggle {
    position: absolute; right: 14px; bottom: 14px; z-index: 1;
    padding: 6px 12px; border-radius: 7px; border: 1px solid var(--line-strong);
    background: rgb(7 10 16 / 0.78); color: var(--text); font: 500 13px/1 var(--font); cursor: pointer;
  }
  /* Phones get the same clip stacked: 24 FPS on top, 60 FPS below. */
  @media (max-width: 640px) {
    .motion video { aspect-ratio: 640 / 720; }
    .motion::after { top: 50%; bottom: auto; left: 0; right: 0; width: auto; height: 2px; margin: -1px 0 0; }
    .motion-labels { inset: 0; }
    .motion-labels span { position: absolute; left: 12px; top: 12px; }
    .motion-labels span:last-child { top: calc(50% + 12px); }
  }

  /* Features */
  .features { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .feature { padding: 32px 32px 8px 0; display: flex; flex-direction: column; gap: 18px; }
  .feature + .feature { padding-left: 32px; border-left: 1px solid var(--line); }
  .feature h3 { font-size: 1.3rem; }
  .feature ul { display: grid; gap: 10px; color: var(--text-2); }
  .feature li { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  .feature li .mono { color: var(--text-3); }
  .formats { margin-top: auto; padding-top: 10px; color: var(--text-3); }
  .more { margin-top: 40px; color: var(--text-2); }
  @media (max-width: 860px) {
    .features { grid-template-columns: 1fr; }
    .feature, .feature + .feature { padding: 28px 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }

  /* Steps: the crossbar runs under all four, ending in its dot. */
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; position: relative; padding-top: 36px; }
  .steps::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 9px;
    background:
      radial-gradient(circle at calc(100% - 4.5px) 50%, var(--accent) 4.5px, transparent 5px),
      linear-gradient(var(--accent), var(--accent)) 0 50% / calc(100% - 6px) 2px no-repeat;
    transform-origin: 0 50%;
    transition: transform 1.4s var(--ease);
  }
  .js .steps:not(:has(.in))::before { transform: scaleX(0); }
  .steps h3 { font-size: 1.25rem; margin: 10px 0 8px; }
  .steps p { color: var(--text-2); font-size: 16px; }
  .steps .mono { color: var(--accent); }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; gap: 24px; padding-top: 0; padding-left: 28px; }
    .steps::before {
      top: 0; bottom: 0; left: 0; right: auto; width: 9px; height: auto;
      background:
        radial-gradient(circle at 50% calc(100% - 4.5px), var(--accent) 4.5px, transparent 5px),
        linear-gradient(var(--accent), var(--accent)) 50% 0 / 2px calc(100% - 6px) no-repeat;
      transform-origin: 50% 0;
    }
    .js .steps:not(:has(.in))::before { transform: scaleY(0); }
  }

  /* Editors */
  .editors-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(40px, 7vw, 96px); align-items: start; }
  .trio { color: var(--text) !important; font-size: clamp(1.25rem, 2.2vw, 1.6rem) !important; line-height: 1.35; font-weight: 500; letter-spacing: -0.015em; }
  .fps { display: flex; align-items: center; gap: 18px; font: 600 clamp(3rem, 8vw, 5.5rem)/1 var(--font); letter-spacing: -0.04em; margin-bottom: 40px; font-variant-numeric: tabular-nums; }
  .fps span:first-child { color: var(--text-3); }
  .fps .to {
    width: clamp(48px, 9vw, 110px); height: 12px; flex: none;
    background:
      radial-gradient(circle at calc(100% - 6px) 50%, var(--accent) 6px, transparent 6.5px),
      linear-gradient(var(--accent), var(--accent)) 0 50% / calc(100% - 8px) 3px no-repeat;
  }
  .fps small { font-size: 0.32em; font-weight: 500; color: var(--text-2); letter-spacing: 0; align-self: flex-end; margin-bottom: 0.5em; }
  .points { display: grid; grid-template-columns: 1fr 1fr; gap: 26px 40px; }
  .points h3 { font-size: 1.05rem; margin-bottom: 6px; }
  .points p { color: var(--text-2); font-size: 16px; }
  .panel-shot { margin: 0; position: sticky; top: 96px; }
  .panel-shot img { width: 316px; border-radius: 12px; border: 1px solid var(--line-strong); box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.7); }
  .panel-shot figcaption { margin-top: 14px; font-size: 14px; }
  @media (max-width: 900px) {
    .editors-grid { grid-template-columns: 1fr; }
    .panel-shot { position: static; justify-self: center; }
  }
  @media (max-width: 560px) {
    .points { grid-template-columns: 1fr; }
    .panel-shot img { width: min(316px, 100%); }
  }

  /* Performance */
  .perf { background: var(--bg-deep); border-block: 1px solid var(--line); }
  .perf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px; }
  .perf-grid h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .perf-grid p { color: var(--text-2); font-size: 16px; }
  @media (max-width: 960px) { .perf-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .perf-grid { grid-template-columns: 1fr; gap: 28px; } }

  /* Local */
  .local-inner { display: grid; justify-items: center; text-align: center; gap: 18px; max-width: 720px; }
  .local-icon { width: 52px; height: 52px; color: var(--text-2); margin-bottom: 6px; }
  .local h2 { font-size: clamp(2rem, 5vw, 3.4rem); }
  .local p { color: var(--text-2); font-size: clamp(1.02rem, 1.4vw, 1.14rem); max-width: 52ch; }
  .local .fine { font-size: 14px; color: var(--text-3); }

  /* Open source */
  .oss-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
  .oss-grid .section-head { margin-bottom: 0; }
  .oss-list { margin: 0; border-top: 1px solid var(--line); }
  .oss-list div { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .oss-list dt { color: var(--text-3); font-family: var(--mono); font-size: 13px; padding-top: 3px; }
  .oss-list dd { margin: 0; color: var(--text-2); }
  @media (max-width: 860px) {
    .oss-grid { grid-template-columns: 1fr; }
