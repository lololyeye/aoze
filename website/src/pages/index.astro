  }

  /* Final */
  .final { padding-top: 0; }
  .final-inner {
    display: grid; justify-items: center; gap: 22px; text-align: center;
    padding: clamp(48px, 7vw, 80px) 24px; border-radius: 20px;
    background: var(--surface); border: 1px solid var(--line);
  }
  .final h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .final p { font-size: 14px; }
</style>

<script>
  // Hero screenshots: Image & GIF / Home.
  const shots = document.querySelector<HTMLElement>("[data-shots]")!;
  shots.querySelectorAll<HTMLButtonElement>("[data-show]").forEach((b) =>
    b.addEventListener("click", () => {
      shots.querySelectorAll<HTMLButtonElement>("[data-show]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      shots.querySelectorAll<HTMLImageElement>("[data-shot]").forEach((img) => {
        const on = img.dataset.shot === b.dataset.show;
        if (on) img.loading = "eager";
        img.classList.toggle("is-active", on);
      });
    }),
  );
  // Flatten the window once it is on screen.
  new IntersectionObserver(([e], io) => {
    if (e.isIntersecting) {
      shots.classList.add("in");
      io.disconnect();
    }
  }, { threshold: 0.25 }).observe(shots);

  // Demo tabs (WAI-ARIA tabs pattern).
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.demo-tabs [role="tab"]')];
  const video = document.querySelector<HTMLVideoElement>("video[data-autoplay]")!;
  const toggle = document.querySelector<HTMLButtonElement>(".motion-toggle")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let userPaused = reduce;
  if (matchMedia("(max-width: 640px)").matches) {
    video.poster = video.dataset.tallPoster!;
    video.src = video.dataset.tall!;
    video.width = 640;
    video.height = 720;
  } else {
    video.src = video.dataset.wide!;
  }

  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    }
    if (tab.id === "tab-motion" && !userPaused) video.play().catch(() => {});
    else video.pause();
    syncToggle();
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    t.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });

  // The clip only plays while visible, and never on its own with reduced motion.
  const syncToggle = () => {
    const playing = !video.paused;
    toggle.textContent = playing ? "Pause" : "Play";
    toggle.setAttribute("aria-pressed", String(!playing));
  };
  toggle.addEventListener("click", () => {
    if (video.paused) {
      userPaused = false;
      video.play().catch(() => {});
    } else {
      userPaused = true;
      video.pause();
    }
  });
  video.addEventListener("play", syncToggle);
  video.addEventListener("pause", syncToggle);
  new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) video.pause();
    else if (!userPaused) video.play().catch(() => {});
  }, { threshold: 0.4 }).observe(video);
  syncToggle();
</script>
