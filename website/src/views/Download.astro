---
import Base from "../layouts/Base.astro";
import { ui, type Lang } from "../i18n/ui";
import Logo from "../components/Logo.astro";
import KofiButton from "../components/KofiButton.astro";
import DownloadCount from "../components/DownloadCount.astro";
import ReleaseSync from "../components/ReleaseSync.astro";
import InstallNotice from "../components/InstallNotice.astro";
import { latestRelease, version, formatSize, formatDate, sha256 } from "../lib/release";
import { GITHUB_URL, RELEASES_URL } from "../lib/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].download;
const release = await latestRelease();
const v = version(release);
const hash = sha256(release);
---
<Base lang={lang} path="download/" title={t.title} description={t.description(v)}>
  <section class="dl">
    <div class="wrap dl-grid">
      <div class="dl-main">
        <Logo class="dl-logo" />
        <h1>{t.h1}</h1>
        <p class="lead">{t.lead}</p>

        <div class="dl-row">
        <a class="btn btn-primary btn-lg" href={release.asset.url} data-r="href:asset.url" data-installer>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" /></svg>
          {t.button}
        </a>
        <KofiButton lang={lang} short />
        <DownloadCount lang={lang} />
        </div>
        <p class="sub">{t.sub} <span data-r="size">{formatSize(release.asset.size, lang)}</span></p>

        <dl class="facts">
          <div><dt>{t.version}</dt><dd>Aoze <span data-r="version">{v}</span></dd></div>
          <div><dt>{t.released}</dt><dd><time datetime={release.publishedAt} data-r="date">{formatDate(release.publishedAt, lang)}</time></dd></div>
          <div><dt>{t.file}</dt><dd class="mono" data-r="name">{release.asset.name}</dd></div>
          <div><dt>{t.size}</dt><dd data-r="size">{formatSize(release.asset.size, lang)}</dd></div>
          <div><dt>{t.system}</dt><dd>{t.systemText}</dd></div>
          <div><dt>{t.source}</dt><dd>{t.sourceText} <a class="link" href={release.url} data-r="href:url">GitHub (lololyeye/aoze)</a></dd></div>
        </dl>
      </div>

      <aside class="dl-side">
        <div class="card">
          <h2>{t.checkTitle}</h2>
          {hash ? (
            <>
              <p>{t.checkHash}</p>
              <code class="hash" data-r="hash">{hash}</code>
              <button class="btn btn-ghost btn-sm copy" type="button" data-copy data-copied={t.copied} data-fail={t.copyFail}>{t.copy}</button>
              <p>{t.checkWhy}</p>
              <p>{t.checkCmd}</p>
              <code class="cmd">Get-FileHash .\<span data-r="name">{release.asset.name}</span></code>
            </>
          ) : (
            <p>{t.noHash}</p>
          )}
        </div>
        <div class="card">
          <h2>{t.signTitle}</h2>
          <p>{t.signText[0]} <strong>{t.signText[1]}</strong>{t.signText[2]} <strong>{t.signText[3]}</strong>{t.signText[4]}</p>
        </div>
        <div class="card">
          <h2>{t.installTitle}</h2>
          <p>{t.installText}</p>
        </div>
        <div class="card">
          <h2>{t.updateTitle}</h2>
          <p>{t.updateText}</p>
        </div>
        <div class="card">
          <h2>{ui[lang].kofi.title}</h2>
          <p>{ui[lang].kofi.text} {t.donateNote}</p>
          <KofiButton lang={lang} size="sm" />
        </div>
      </aside>
    </div>
  </section>

  <section class="notes">
    <div class="wrap">
      <div class="notes-head">
        <h2 data-r="notes-title">{t.notes(release.name)}</h2>
        <a class="link" href={release.url} data-r="href:url">{t.viewOnGitHub}</a>
      </div>
      {t.notesLang && <p class="notes-lang">{t.notesLang}</p>}
      <div class="changelog" lang="en" data-r="html:bodyHtml" set:html={release.bodyHtml} />
      <p class="older">
        {t.older} <a class="link" href={RELEASES_URL}>{t.allReleases}</a>.
        <a class="link" href={GITHUB_URL}>{t.sourceCode}</a>
      </p>
    </div>
  </section>
</Base>

<ReleaseSync lang={lang} />
<InstallNotice lang={lang} />

<script is:inline>
  const copy = document.querySelector("[data-copy]");
  const label = copy?.textContent;
  copy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(document.querySelector('[data-r="hash"]').textContent.trim());
      copy.textContent = copy.dataset.copied;
    } catch {
      copy.textContent = copy.dataset.fail;
    }
    setTimeout(() => (copy.textContent = label), 1800);
  });
</script>

<style>
  .dl { padding-block: clamp(48px, 8vw, 96px) clamp(48px, 6vw, 80px); }
  .dl-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(40px, 6vw, 88px); align-items: start; }
  .dl-main { display: grid; justify-items: start; gap: 18px; }
  .dl-main :global(.dl-logo) { width: 56px; height: 56px; margin-bottom: 8px; }
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); letter-spacing: -0.035em; }
  .lead { color: var(--text-2); font-size: 1.15rem; margin-bottom: 10px; }
  .dl-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .sub { color: var(--text-3); font-size: 14px; }
  .facts { margin: 28px 0 0; width: 100%; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .facts dt { color: var(--text-3); font: 500 13px/1.6 var(--mono); padding-top: 1px; }
  .facts dd { margin: 0; color: var(--text-2); overflow-wrap: anywhere; }
  .facts dd.mono { font-size: 14px; }

  .dl-side { display: grid; gap: 14px; }
  .card { padding: 22px 24px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); display: grid; gap: 12px; justify-items: start; }
  .card h2 { font-size: 1.05rem; letter-spacing: -0.01em; }
  .card p { color: var(--text-2); font-size: 15px; }
  .card strong { color: var(--text); font-weight: 600; }
  .hash, .cmd {
    display: block; width: 100%; padding: 12px 14px; border-radius: 8px;
    background: var(--bg-deep); border: 1px solid var(--line);
    font: 13px/1.5 var(--mono); color: var(--text); overflow-wrap: anywhere; user-select: all;
  }
  .cmd { user-select: text; }

  .notes { padding-top: 0; }
  .notes-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; padding-top: 40px; border-top: 1px solid var(--line); margin-bottom: 24px; }
  .notes-head h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .changelog { max-width: 760px; color: var(--text-2); display: grid; gap: 14px; }
  .changelog :global(ul) { list-style: none; display: grid; gap: 8px; }
  .changelog :global(li) { position: relative; padding-left: 20px; }
  .changelog :global(li)::before { content: ""; position: absolute; left: 0; top: 0.75em; width: 8px; height: 2px; background: var(--accent); }
  .changelog :global(strong) { color: var(--text); font-weight: 600; }
  .changelog :global(code) { font: 0.85em var(--mono); color: var(--text); overflow-wrap: anywhere; }
  .changelog :global(a) { color: var(--text); }
  .older { margin-top: 40px; color: var(--text-2); }
  .notes-lang { color: var(--text-3); font-size: 14px; margin: -8px 0 18px; }

  @media (max-width: 900px) {
    .dl-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .facts div { grid-template-columns: 1fr; gap: 2px; }
    .dl-main .btn { width: 100%; justify-content: center; }
  }
</style>
